# ---------------------------------------------------------------------------
# Policy Prism - copy this file to server/.env before running the API.
#
#   cp .env.example server/.env
#
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#  local  : postgresql://postgres:postgres@localhost:5432/policy_prism
#  Neon   : postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#  Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policy_prism

# Signing key for JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# API port.
PORT=4000

# Where the frontend runs. Comma-separate to allow more than one origin.
# In production this is your Vercel URL, e.g. https://policy-prism.vercel.app
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Uploaded documents. Note that most hosts have ephemeral disks - the parsed
# text is stored in Postgres, so a wiped upload directory loses nothing.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Password given to the four demo accounts by `npm run db:seed`.
SEED_PASSWORD=PolicyPrism!2026

# morgan format: dev | combined | tiny | silent
LOG_LEVEL=dev

# ---------------------------------------------------------------------------
# Email (password reset links)
#
# Set ONE of the two blocks below. With neither, password reset still works but
# the link is shown on screen in development instead of being delivered.
# ---------------------------------------------------------------------------

# Public URL of the app - used to build the link inside the email.
APP_URL=http://localhost:4000
MAIL_FROM=Policy Prism <onboarding@resend.dev>

# Option 1 - Resend (https://resend.com). No extra dependency; free tier is
# enough for testing. Create an API key and paste it here.
RESEND_API_KEY=

# Option 2 - any SMTP server (Gmail, Postmark, SES, Mailtrap).
# Requires: npm install nodemailer
# Gmail needs an App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# ---------------------------------------------------------------------------
# AI semantic analysis (policy mapping and gap analysis)
#
# Any OpenAI-compatible endpoint works. Unset, Policy Prism runs the
# deterministic lexical engine alone and labels every finding accordingly.
#
#   OpenAI     AI_BASE_URL=https://api.openai.com/v1
#   Groq       AI_BASE_URL=https://api.groq.com/openai/v1
#   Together   AI_BASE_URL=https://api.together.xyz/v1
#   Ollama     AI_BASE_URL=http://localhost:11434/v1
#   Anthropic  AI_BASE_URL=https://api.anthropic.com/v1  (chat only - pair with
#              an OpenAI-compatible AI_EMBEDDING_BASE_URL for embeddings)
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Only when embeddings come from a different provider to chat.
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

# Policy sections retrieved per requirement and sent to the model as evidence.
AI_RETRIEVAL_K=6
# Requirements evaluated at once. Raise carefully against provider rate limits.
AI_CONCURRENCY=4
# Free tiers rate limit hard. Lower concurrency and add a delay between
# requests if you see "rate limiting this key" in the log.
AI_MAX_RETRIES=4
AI_RETRY_BASE_MS=2000
AI_REQUEST_DELAY_MS=0
AI_TIMEOUT_MS=45000
